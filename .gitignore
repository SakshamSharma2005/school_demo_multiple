# ==========================================
# Git Ignore - AI Bootcamp / Computer Vision & Voice Assistant
# ==========================================

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Environment Variables & Secrets (CRITICAL: Do NOT commit API keys)
.env
.env.local
.env.*.local

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Large AI Model Weights & Checkpoints (YOLO, PyTorch, MediaPipe)
*.pt
*.pth
*.onnx
*.tflite
*.weights
*.bin
yolov8n.pt
runs/

# Temporary Audio & TTS files
*.mp3
*.wav
temp/
tmp/

# OS-generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# Editor & IDE Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Logs & Diagnostics
*.log
report.json
